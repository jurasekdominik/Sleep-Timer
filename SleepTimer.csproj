<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework WPF is part of Windows' .NET Framework: no bundled runtime or UI library. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><LangVersion>10</LangVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SleepTimer</AssemblyName><RootNamespace>SleepTimer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>assets\SleepTimer.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" Exclude="src/MainForm.cs" />
    <Resource Include="assets/SleepTimer.ico" />
  </ItemGroup>
</Project>
